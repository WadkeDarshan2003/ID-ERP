rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuth() { return request.auth != null; }
    
    // -------- Users Collection --------
    // Allow authenticated users to read all users in same tenant
    // Allow users to write their own document
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        request.auth.uid == userId || 
        request.auth.uid == resource.data.createdBy ||
        resource.data.tenantId == null ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == resource.data.tenantId
      );
    }
    
    // -------- Tenants Collection --------
    match /tenants/{tenantId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update, delete: if isAuth();
    }
    
    // -------- Tenant Subcollections --------
    match /tenants/{tenantId}/{doc=**} {
      allow read, write: if isAuth();
    }
    
    // -------- Projects Collection --------
    match /projects/{projectId} {
      allow read, write: if isAuth();
    }
    match /projects/{projectId}/{sub=**} {
      allow read, write: if isAuth();
    }
    
    // -------- Role Collections --------
    match /vendors/{docId} {
      allow read, write: if isAuth();
    }
    match /designers/{docId} {
      allow read, write: if isAuth();
    }
    match /clients/{docId} {
      allow read, write: if isAuth();
    }
    match /admins/{docId} {
      allow read, write: if isAuth();
    }
  }
}