rules_version = '3';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuth() { return request.auth != null; }
    
    // -------- Users Collection --------
    // Allow authenticated users to read all users in same tenant
    // Allow users to write their own document
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        request.auth.uid == userId || 
        request.auth.uid == resource.data.createdBy ||
        resource.data.tenantId == null ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == resource.data.tenantId
      );
    }
    
    // -------- Tenants Collection --------
    match /tenants/{tenantId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update, delete: if isAuth();
    }
    
    // -------- Tenant Subcollections --------
    match /tenants/{tenantId}/{doc=**} {
      allow read, write: if isAuth();
    }
    
    // -------- Projects Collection --------
    match /projects/{projectId} {
      allow read, write: if isAuth();
    }
    match /projects/{projectId}/{sub=**} {
      allow read, write: if isAuth();
    }
    
    // -------- Role Collections --------
    // Vendors with multi-tenant support (tenantIds array)
    match /vendors/{docId} {
      allow read, write: if isAuth() && (
        request.auth.uid == docId ||
        request.auth.token.role == 'admin' ||
        // Check if admin's tenantId is in vendor's tenantIds array
        (resource.data.tenantIds != null && 
         request.auth.token.tenantId in resource.data.tenantIds) ||
        // Backward compatibility: check single tenantId field
        request.auth.token.tenantId == resource.data.tenantId
      );
    }
    
    // Designers with multi-tenant support (tenantIds array)
    match /designers/{docId} {
      allow read, write: if isAuth() && (
        request.auth.uid == docId ||
        request.auth.token.role == 'admin' ||
        // Check if admin's tenantId is in designer's tenantIds array
        (resource.data.tenantIds != null && 
         request.auth.token.tenantId in resource.data.tenantIds) ||
        // Backward compatibility: check single tenantId field
        request.auth.token.tenantId == resource.data.tenantId
      );
    }
    
    match /clients/{docId} {
      allow read, write: if isAuth() && request.auth.token.tenantId == resource.data.tenantId;
    }
    match /admins/{docId} {
      allow read, write: if isAuth() && request.auth.token.tenantId == resource.data.tenantId;
    }
  }
}